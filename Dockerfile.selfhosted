# syntax=docker/dockerfile:1

FROM node:24.19.0-bookworm-slim AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

FROM base AS deps
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json .npmrc ./
RUN npm ci

FROM base AS ops
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NODE_ENV=production \
    RUNTIME_ENV_FILE=/run/secrets/runtime_env
COPY infra/self-hosted/runtime/entrypoint.sh /usr/local/bin/exam-generator-ops-entrypoint
RUN chmod 0555 /usr/local/bin/exam-generator-ops-entrypoint
ENTRYPOINT ["/usr/local/bin/exam-generator-ops-entrypoint"]
CMD ["node", "--version"]

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NODE_ENV=production
RUN npx next build --webpack

FROM node:24.19.0-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates fontconfig fonts-dejavu-core \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 10001 exam \
  && useradd --system --uid 10001 --gid 10001 --home-dir /app --shell /usr/sbin/nologin exam

COPY --from=builder --chown=10001:10001 /app/public ./public
COPY --from=builder --chown=10001:10001 /app/.next/standalone ./
COPY --from=builder --chown=10001:10001 /app/.next/static ./.next/static
COPY --from=builder /app/infra/self-hosted/runtime/entrypoint.sh /usr/local/bin/exam-generator-entrypoint

RUN chmod 0555 /usr/local/bin/exam-generator-entrypoint \
  && mkdir -p /data/textbooks /app/.next/cache \
  && chown -R 10001:10001 /data/textbooks /app/.next/cache

USER 10001:10001
EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/exam-generator-entrypoint"]
CMD ["node", "server.js"]
