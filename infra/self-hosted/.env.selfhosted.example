# Local parity harness only. Never place production credentials in this file.
SELFHOSTED_DB_NAME=exam_generator_parity
SELFHOSTED_DB_USER=exam_parity_owner
SELFHOSTED_DB_PASSWORD=replace-with-a-local-development-password
SELFHOSTED_DB_PORT=55432

# Application integration-test connection only. The role is non-superuser and
# can enter only the two fixed compatibility roles used by the RPC adapters.
DATABASE_URL=postgresql://exam_app_runtime:local-parity-runtime-only@127.0.0.1:55432/exam_generator_parity
