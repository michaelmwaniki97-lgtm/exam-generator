# Database RPC transport. Missing DATABASE_BACKEND also means supabase.
DATABASE_BACKEND=supabase

# Server-only. Required only when DATABASE_BACKEND=postgres.
# Never expose this value through a NEXT_PUBLIC_ variable.
DATABASE_URL=

# Authentication backend. Phase 1 keeps Supabase as the default and current
# application auth flows still use Supabase until the explicit Auth cutover.
AUTH_BACKEND=supabase

# Required only after AUTH_BACKEND=better-auth is deliberately enabled.
# Generate BETTER_AUTH_SECRET with at least 32 high-entropy characters.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
