# Normal development defaults to PostgreSQL when this selector is omitted.
# Production requires an explicit selector. Use supabase only for a reviewed
# compatibility/rollback deployment.
DATABASE_BACKEND=postgres

# Server-only. Required only when DATABASE_BACKEND=postgres.
# Never expose this value through a NEXT_PUBLIC_ variable.
DATABASE_URL=

# Normal development defaults to Better Auth when this selector is omitted.
# Production requires an explicit selector. Supabase remains available only as
# the reviewed compatibility/rollback path.
# Production Better Auth traffic may be accepted only with PostgreSQL after the
# UUID import, manual identity-FK cutover, handler/runtime acceptance, and
# recovery checks are clean. Disposable local/staging databases may select it
# earlier for migration rehearsal.
AUTH_BACKEND=better-auth

# Auth migration lifecycle. compatibility is the safe/default pre-acceptance
# state. rollback-window requires PostgreSQL + cutover-freeze and permits the
# reviewed Better Auth/Supabase authority selector while rollback is still live.
# accepted requires Better Auth + PostgreSQL + normal mutations and permanently
# ends configuration-only Supabase Auth rollback for new identity/credential data.
AUTH_CUTOVER_STATE=compatibility

# Keep normal during ordinary operation. Set cutover-freeze before the final
# Supabase Auth delta export and keep it through the rollback acceptance window.
# Login/logout/session validation remain available; signup and password
# recovery/reset are blocked at both the app boundary and /api/auth HTTP surface.
AUTH_MUTATION_MODE=normal

# Required only after AUTH_BACKEND=better-auth is deliberately enabled.
# Generate BETTER_AUTH_SECRET with at least 32 high-entropy characters.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Canonical browser origin used for auth/recovery links. Must match the
# BETTER_AUTH_URL origin at traffic cutover and must use HTTPS in production.
PUBLIC_APP_URL=http://localhost:3000

# Server-only generic SMTP transport for Better Auth recovery emails.
# Use an smtp:// URL for STARTTLS-capable ports such as 587, or smtps:// for
# implicit TLS such as port 465. Percent-encode special characters in credentials.
SMTP_URL=
AUTH_EMAIL_FROM="Exam Generator <no-reply@example.com>"

# Private textbook storage. Development defaults to an ignored absolute path at
# .next/development-textbooks when both variables are omitted. Production
# requires filesystem plus an absolute private mount not exposed by the proxy.
TEXTBOOK_STORAGE_BACKEND=filesystem
TEXTBOOK_STORAGE_ROOT=

# AI provider used for exam generation. Set one explicit provider and its
# server-only key in the self-hosted deployment. Model overrides are optional.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Payment provider. Daraja credentials remain server-only and unchanged by the
# infrastructure migration. Production requires the verified Safaricom query URL.
PAYMENT_PROVIDER=daraja
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORTCODE=
MPESA_PARTY_B=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_QUERY_URL=

# Legacy Supabase rollback/fallback credentials. They are not required by the
# accepted self-hosted runtime (PostgreSQL + Better Auth + filesystem). Keep
# them only while a reviewed fallback/maintenance workflow still needs them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 12 VPS Compose reads non-secret production settings from
# deploy/selfhosted.env and server-only credentials from mounted Docker secret
# files. See deploy/selfhosted.env.example and deploy/secrets/*.example.
