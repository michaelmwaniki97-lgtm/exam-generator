# Database RPC transport. Missing DATABASE_BACKEND also means supabase.
DATABASE_BACKEND=supabase

# Server-only. Required only when DATABASE_BACKEND=postgres.
# Never expose this value through a NEXT_PUBLIC_ variable.
DATABASE_URL=

# Authentication backend. Supabase remains the default. Phase 4 can route
# signup/login/logout and password recovery/reset through Better Auth only in a
# deliberate PostgreSQL staging configuration; middleware remains Supabase
# until its explicit cutover phase.
AUTH_BACKEND=supabase

# Required only after AUTH_BACKEND=better-auth is deliberately enabled.
# Generate BETTER_AUTH_SECRET with at least 32 high-entropy characters.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Server-only generic SMTP transport for Better Auth recovery emails.
# Use an smtp:// URL for STARTTLS-capable ports such as 587, or smtps:// for
# implicit TLS such as port 465. Percent-encode special characters in credentials.
SMTP_URL=
AUTH_EMAIL_FROM="Exam Generator <no-reply@example.com>"
