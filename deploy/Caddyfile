{
  email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
  encode zstd gzip

  request_body {
    max_size 14MB
  }

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
    Strict-Transport-Security "max-age=31536000"
  }

  reverse_proxy app:3000 {
    health_uri /api/health
    health_interval 30s
    health_timeout 5s
    health_fails 2
    health_passes 1
    fail_duration 30s
    max_fails 2
  }
}
