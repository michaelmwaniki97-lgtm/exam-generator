# Copy to deploy/selfhosted.env on the VPS and edit there. Do not commit the copy.
APP_DOMAIN=exams.example.com
ACME_EMAIL=admin@example.com
POSTGRES_OWNER_PASSWORD_FILE=./deploy/secrets/postgres_owner_password
RUNTIME_ENV_FILE=./deploy/secrets/runtime.env

POSTGRES_DB=exam_generator
POSTGRES_USER=exam_db_owner
POSTGRES_HOST=database
POSTGRES_PORT=5432

DATABASE_BACKEND=postgres
AUTH_BACKEND=better-auth
AUTH_CUTOVER_STATE=accepted
AUTH_MUTATION_MODE=normal
PUBLIC_APP_URL=https://exams.example.com
BETTER_AUTH_URL=https://exams.example.com
AUTH_EMAIL_FROM=Exam Generator <no-reply@example.com>

TEXTBOOK_STORAGE_BACKEND=filesystem
TEXTBOOK_STORAGE_ROOT=/data/textbooks

AI_PROVIDER=nvidia
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=openai/gpt-oss-120b

PAYMENT_PROVIDER=daraja
MPESA_ENVIRONMENT=sandbox
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Production only: https://api.safaricom.co.ke/mpesa/stkpushquery/v1/query
MPESA_QUERY_URL=
