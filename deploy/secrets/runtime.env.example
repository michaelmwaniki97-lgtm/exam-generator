# Copy to deploy/secrets/runtime.env, chmod 600, and replace every placeholder.
# Values are read literally after the first '='; do not wrap them in shell quotes.
POSTGRES_RUNTIME_PASSWORD=replace-with-a-different-long-random-runtime-password
DATABASE_URL=postgresql://exam_app_runtime:percent-encode-the-runtime-password@database:5432/exam_generator
BETTER_AUTH_SECRET=replace-with-at-least-32-high-entropy-characters
SMTP_URL=smtps://username:password@smtp.example.com:465
NVIDIA_API_KEY=replace-if-AI_PROVIDER-is-nvidia
OPENAI_API_KEY=
GROQ_API_KEY=
MPESA_CONSUMER_KEY=replace-me
MPESA_CONSUMER_SECRET=replace-me
MPESA_BUSINESS_SHORTCODE=replace-me
MPESA_PARTY_B=replace-me
MPESA_PASSKEY=replace-me
