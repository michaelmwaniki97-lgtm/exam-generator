{
  "name": "exam-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:structures": "node --test --experimental-strip-types lib/assessment/structure-rules.test.ts components/exam-wizard/state.test.ts",
    "test:components": "node --test --experimental-strip-types lib/assessment/component-rules.test.ts",
    "test:blueprint": "node --test --experimental-strip-types lib/blueprint/engine.test.ts",
    "test:curriculum-selection": "node --test --experimental-strip-types lib/curriculum/exam-selection.test.ts",
    "test:assessment": "node --test --experimental-strip-types lib/assessment/rules.test.ts lib/assessment/validation.test.ts lib/curriculum/exam-selection.test.ts components/exam-wizard/state.test.ts",
    "test:curriculum": "node --test scripts/validate-curriculum-data.test.mjs scripts/curriculum-import-plan.test.mjs",
    "curriculum:audit": "node --env-file=.env.local scripts/audit-live-curriculum.mjs",
    "curriculum:import:dry-run": "node --env-file=.env.local scripts/import-verified-curriculum.mjs",
    "curriculum:import": "node --env-file=.env.local scripts/import-verified-curriculum.mjs --apply",
    "test:security": "node --test --experimental-strip-types lib/security/core.test.ts lib/auth/validation.test.ts lib/assessment/validation.test.ts",
    "test:create-exam": "node --test --experimental-strip-types lib/assessment/validation.test.ts lib/curriculum/exam-selection.test.ts components/exam-wizard/state.test.ts",
    "test:textbooks": "node --test --experimental-strip-types lib/textbooks/ingestion.test.ts lib/textbooks/retrieval.test.ts lib/textbooks/security.test.ts",
    "test": "node --test --experimental-strip-types lib/auth/access.test.ts lib/admin/validation.test.ts",
    "test:selfhosted-readiness": "node --test --experimental-strip-types lib/self-hosted/readiness-contract.test.ts",
    "selfhosted:check": "node --experimental-strip-types scripts/check-selfhosted-readiness.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.7.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.7.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "nodemailer": "^9.0.5",
    "openai": "^7.4.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
